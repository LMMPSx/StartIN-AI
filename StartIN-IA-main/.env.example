# Copie para .env (local) ou cadastre no painel do Vercel > Settings > Environment Variables
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b
# URL publica do backend no Railway (com ou sem /api no final)
BACKEND_API_URL=https://seu-backend.up.railway.app/api
# Opcional: protege o endpoint /api/ai/cron/daily (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Opcional: forca ligar/desligar o agendador interno (padrao: ligado localmente, desligado no Vercel)
ENABLE_INTERNAL_SCHEDULER=
